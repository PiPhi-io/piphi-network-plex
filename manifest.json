{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-plex",
  "name": "Plex Media Server",
  "version": "0.1.0",
  "description": "Browse and control one or more Plex Media Servers through PiPhi Network.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "cloud-polling-api",
    "domain": "local-device",
    "upstream_api_status": "plex-media-server-http-api"
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "marketplace": {
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-plex/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "stable",
      "rollout_percent": 100,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "metadata_version": 2,
    "display_name": "Plex Media Server",
    "summary": "Browse Plex libraries and use Plex media, servers, and players in PiPhi dashboards.",
    "category": "media",
    "device_types": [
      "media_server",
      "media_player"
    ],
    "protocols": [
      "http",
      "https",
      "plex_media_server_api"
    ],
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "discovery_methods": [
      "account",
      "manual"
    ],
    "connectivity": "hybrid",
    "offline_support": "partial",
    "privacy_url": "https://www.plex.tv/about/privacy-legal/",
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-plex/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "plex_account",
        "label": "Plex account access",
        "reason": "Discovers the Plex servers available to the configured account.",
        "required": true
      },
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Connects directly to local Plex Media Servers when available.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Plex",
        "model": "Plex Media Server",
        "regions": [
          "WW"
        ]
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-plex",
    "support_url": "https://github.com/PiPhi-io/piphi-network-plex/issues"
  },
  "license": "Apache-2.0",
  "image": "docker.io/piphinetwork/piphi-network-plex:0.1.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "docker.io/piphinetwork/piphi-network-plex:0.1.0",
        "ports": [
          {
            "container": 8091,
            "host": 8091
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "account"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command",
      "provider_instances": "/provider/instances",
      "provider_collections": "/provider/{instance_id}/collections",
      "provider_items": "/provider/{instance_id}/items",
      "provider_resolve": "/provider/{instance_id}/resolve",
      "provider_actions": "/provider/{instance_id}/actions"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "base_url",
      "token",
      "poll_interval_seconds",
      "include_remote_servers",
      "simulation_mode"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "token",
      "base_url"
    ]
  },
  "identity": {
    "fields": [
      "token",
      "base_url"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "server_count": {
      "kind": "sensor",
      "unit": "servers"
    },
    "active_sessions": {
      "kind": "sensor",
      "unit": "sessions"
    },
    "transcode_sessions": {
      "kind": "sensor",
      "unit": "sessions"
    },
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh Plex servers and state.",
      "timeout_ms": 15000
    }
  },
  "entities": [
    {
      "id": "plex-server",
      "name": "Plex Media Server",
      "device_id": "plex-server",
      "device_class": "media_server",
      "entity_type": "media_library",
      "capabilities": [
        "connected",
        "server_count",
        "active_sessions",
        "transcode_sessions",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button",
          "external-widget"
        ],
        "default_widget": "tile",
        "recommended_widgets": [
          "external-widget"
        ]
      }
    }
  ],
  "ui": {
    "experience_packages": [
      {
        "registry_id": "io.piphi.plex-media",
        "auto_install": true
      }
    ],
    "widget_packages": [
      {
        "id": "io.piphi.plex.server-overview",
        "name": "Plex server overview",
        "version": "0.1.10",
        "entry": "/widgets/plex-server-overview/dist/widget.js",
        "binding_modes": [
          "read"
        ],
        "value_kinds": [
          "numeric",
          "boolean"
        ],
        "capability_requirements": [
          "connected",
          "server_count",
          "active_sessions",
          "transcode_sessions"
        ],
        "sdk_compatibility": {
          "minimum": "0.6.0"
        },
        "interaction_targets": [
          {
            "id": "server-card",
            "label": "Plex server overview",
            "kind": "card",
            "allowed_actions": [
              "more-info",
              "popout",
              "refresh"
            ],
            "default_action": "more-info"
          },
          {
            "id": "connected",
            "label": "Plex connection",
            "kind": "binding",
            "binding_slot_id": "connected",
            "allowed_actions": [
              "more-info",
              "popout"
            ],
            "default_action": "more-info"
          },
          {
            "id": "active-sessions",
            "label": "Active Plex sessions",
            "kind": "binding",
            "binding_slot_id": "active-sessions",
            "allowed_actions": [
              "more-info",
              "history",
              "popout"
            ],
            "default_action": "more-info"
          }
        ],
        "settings_schema_version": "1",
        "conformance": {
          "accessibility": "wcag2.2-aa",
          "keyboard": true,
          "themes": [
            "light",
            "dark"
          ],
          "directions": [
            "ltr",
            "rtl"
          ],
          "states": [
            "loading",
            "live",
            "stale",
            "offline",
            "reconnecting",
            "denied",
            "error"
          ]
        },
        "previews": {
          "light": "/widgets/plex-server-overview/preview-light.svg",
          "dark": "/widgets/plex-server-overview/preview-dark.svg"
        },
        "settings": [
          {
            "id": "title",
            "type": "text",
            "label": "Title",
            "default": "Plex servers"
          }
        ],
        "layout": {
          "min_height": 96,
          "default_height": 112,
          "max_height": 140
        },
        "security": {
          "permissions": [],
          "sandbox": [
            "allow-scripts"
          ],
          "csp": {
            "connect_src": []
          }
        },
